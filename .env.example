DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Dotypay (https://portal.dotypay.com) - used to pull terminal totals for a date
DOTYPAY_API_KEY=
# Optional: pin which raw Dotypay terminal ID maps to "Terminal 1" / "Terminal 2".
# If unset, the two terminals found for a date are assigned in sorted TID order.
DOTYPAY_TID_TERMINAL_1=
DOTYPAY_TID_TERMINAL_2=

# Dotykačka Cloud API (api.dotykacka.cz) - used to pull Celková suma, Choice QR
# and Wolt totals for a date. Client ID/Secret come from Dotykačka's Client
# Application registration; Refresh Token + Cloud ID come from completing the
# one-time consent flow at /api/dotykacka/connect; Branch ID is listed at
# GET /v2/clouds/:cloudId/branches (do not assume it equals the Cloud ID).
DOTYKACKA_CLIENT_ID=
DOTYKACKA_CLIENT_SECRET=
DOTYKACKA_BRANCH_ID=
DOTYKACKA_REFRESH_TOKEN=
DOTYKACKA_CLOUD_ID=
